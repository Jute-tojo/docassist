# Copier ce fichier en .env et remplir les valeurs

# Supabase : Connect > Session pooler (remplacer [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Gemini (embeddings)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Groq (génération des réponses)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Adresses du front autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:5173

# Score minimal (0 à 1) pour qu'un passage soit utilisé
SEUIL_SCORE=0.5
