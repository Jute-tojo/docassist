# Copy this file to .env and fill in the values

# Use the Supabase "Session pooler" URL (IPv4), not the direct connection (IPv6 only)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173

SEUIL_SCORE=0.5
